<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFDFFF70"
                android:centerColor="#FFB8DE2E"
                android:endColor="#FF6E8810" />
            <stroke
                android:width="1dp"
                android:color="#E8FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFF1FFA7"
                        android:centerColor="#FFD6FF42"
                        android:endColor="#FF83A515" />
                    <stroke
                        android:width="1dp"
                        android:color="#E8FFFFFF" />
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="2dp"
                android:right="3dp"
                android:bottom="27dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="13dp"
                        android:topRightRadius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#72FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
