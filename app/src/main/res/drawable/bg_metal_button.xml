<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FF15191D"
                        android:centerColor="#FF22282E"
                        android:endColor="#FF080A0C" />
                    <stroke
                        android:width="1dp"
                        android:color="#A6D6FF42" />
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="27dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:endColor="#02FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FF3D454C"
                        android:centerColor="#FF20262B"
                        android:endColor="#FF0B0E11" />
                    <stroke
                        android:width="1dp"
                        android:color="#72FFFFFF" />
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="27dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#46FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item
                android:left="5dp"
                android:right="5dp"
                android:top="30dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#75000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
