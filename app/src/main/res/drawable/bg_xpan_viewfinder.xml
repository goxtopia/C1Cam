<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF070807" />
            <stroke
                android:width="1dp"
                android:color="#66D6FF42" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <stroke
                android:width="1dp"
                android:color="#32FFFFFF" />
        </shape>
    </item>
</layer-list>
