<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF24292E"
                android:endColor="#FF0A0C0E" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF171B1F"
                android:centerColor="#FF272E34"
                android:endColor="#FF090B0D" />
            <stroke
                android:width="1dp"
                android:color="@color/cam_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF3B434A"
                android:centerColor="#FF20262B"
                android:endColor="#FF0A0D0F" />
            <stroke
                android:width="1dp"
                android:color="#72FFFFFF" />
        </shape>
    </item>
</selector>
